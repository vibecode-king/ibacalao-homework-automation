{
  "name": "ibacalao-homework-automation",
  "version": "0.1.0",
  "private": true,
  "description": "iBacalao Homework Automation: a local homework-draft agent that saves drafts for your review and never submits to your school.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/ping.ts",
    "once": "tsx src/ping.ts --once",
    "pair": "tsx src/pair.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts lib/watcher/__tests__/*.test.ts lib/school/__tests__/*.test.ts",
    "check": "npm run typecheck && npm test",
    "mcp": "tsx src/mcp.ts",
    "watcher:bundle": "esbuild scripts/watcher-daemon.ts --bundle --platform=node --format=cjs --target=node22 --external:playwright --outfile=dist/watcher-daemon.cjs",
    "release:check": "node scripts/check-release-version.cjs",
    "desktop:build": "bash native/marginalia/build_app.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.0",
    "fast-check": "^4.10.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.61.1",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "body-parser": "^2.4.0"
  }
}
