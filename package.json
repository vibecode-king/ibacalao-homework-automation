{
  "name": "ibacalao-homework-automation",
  "version": "0.1.0",
  "private": true,
  "description": "iBacalao Homework Automation: a local homework-draft agent that saves drafts for your review and never submits to your school.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/ping.ts",
    "once": "tsx src/ping.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "mcp": "tsx src/mcp.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
