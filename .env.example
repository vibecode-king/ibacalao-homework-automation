# Where your iBacalao account lives (HTTPS required; HTTP only for localhost).
IBACALAO_BASE_URL=https://app.ibacalao.com
# Pair from Homework settings with `npm run pair`; the long-lived token stays local. Never commit it.
IBACALAO_AGENT_TOKEN=

# Your own model endpoint (any OpenAI-compatible /chat/completions API).
# Hosted OpenAI: set only IBACALAO_LLM_API_KEY. Local model: set base URL, leave key empty.
IBACALAO_LLM_BASE_URL=
IBACALAO_LLM_MODEL=
IBACALAO_LLM_API_KEY=
# Output cap per draft, protects your key from runaway spend (1-32000, default 8000).
IBACALAO_LLM_MAX_TOKENS=8000
